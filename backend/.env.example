# Lazaynova backend — NO secrets. Injected at deploy time.

PORT=8787
CORS_ORIGIN=http://localhost:3000

# --- Local inference ONLY (loopback allowlist) ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=lazaynova-core
LOCAL_LLM_TIMEOUT_MS=60000
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=256

# --- Private storage (docker-compose) ---
DATABASE_URL=postgresql://lazaynova:lazaynova@127.0.0.1:5432/lazaynova
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_BUCKET=lazaynova-files
